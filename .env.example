# Copy to .env and fill in. Never commit the real .env (gitignored).

# Archive-node RPC endpoint. Needed for:
#  - crates/tripwire-daemon (live monitoring against a real chain)
#  - contracts/test/replay (historical exploit fork tests)
# Alchemy's free tier works for Ethereum mainnet archive access.
ETH_RPC_URL=

# --- tripwire-daemon ---
TRIPWIRE_RPC_URL=${ETH_RPC_URL}
TRIPWIRE_CHAIN_ID=1
TRIPWIRE_GUARDIAN_ADDRESS=
TRIPWIRE_TARGET_CONTRACT=
# The off-chain hot wallet's private key. PAUSER_ROLE only -- see
# docs/INTEGRATION.md for why this key must never hold any other role.
# NEVER use a key that holds real funds or admin privileges anywhere.
TRIPWIRE_PAUSER_PRIVATE_KEY=
TRIPWIRE_SIGNATURES_DIR=signatures
TRIPWIRE_PAUSE_THRESHOLD=80
TRIPWIRE_MIN_CONFIRMATIONS=1
TRIPWIRE_POLL_INTERVAL_MS=2000
# What the protocol custodies, so the daemon can see funds leaving it: a
# pause needs evidence of harm, and fund flow is the main kind. Comma-
# separated ERC-20 addresses (the protocol's own markets, configured up
# front), extra contracts that hold its assets (e.g. one vault per asset),
# and whether to watch native ETH (needs a call trace).
TRIPWIRE_WATCHED_TOKENS=
TRIPWIRE_EXTRA_HOLDERS=
TRIPWIRE_WATCH_NATIVE=false
TRIPWIRE_TRACK_AMM_PRICES=true
# Call traces: `none` relies on the node serving debug_traceTransaction.
# `cast_run` re-executes transactions locally with Foundry (works on any
# archive RPC, but slow: tens of seconds per transaction on a remote node).
TRIPWIRE_TRACE_FALLBACK=none
TRIPWIRE_TRACE_TIMEOUT_SECS=90
# Blocks remembered for reorg detection, and cap on blocks processed per
# tick while catching up.
TRIPWIRE_REORG_WINDOW=64
TRIPWIRE_MAX_BLOCKS_PER_TICK=32

RUST_LOG=info
